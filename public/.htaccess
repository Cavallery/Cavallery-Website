# ============================================================
# CAVALLERY HOSTINGER / LITESPEED STATIC ASSET OPTIMIZATION
# Bypasses Node.js for static files, streaming videos directly with byte-range
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enable Byte-range requests for videos
  Header set Accept-Ranges bytes
</IfModule>

# Caching & MIME types for media & static assets
<IfModule mod_headers.c>
  # 1 Year Immutable Cache for Videos & Audio
  <FilesMatch "\.(mp4|webm|ogg|mov|mp3|wav)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 1 Year Cache for Images & Fonts
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 1 Month Cache for CSS & JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType audio/mpeg .mp3
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
