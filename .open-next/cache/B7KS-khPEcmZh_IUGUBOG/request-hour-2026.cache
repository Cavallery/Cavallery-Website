[[\"$\",\"p\",null,{\"children\":\"Ketika Request Hour 2026 berakhir, yang tersisa bukan hanya hasil yang tertulis di layar.\"}],[\"$\",\"p\",null,{\"children\":\"Yang tersisa adalah cerita yang berhasil kita ciptakan bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Karena pada akhirnya, kenangan tidak tercipta saat sebuah mimpi terwujud. Kenangan tercipta saat ada banyak orang yang memilih untuk memperjuangkannya bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Dan Request Hour 2026 menjadi salah satu kenangan tersebut.\"}],[\"$\",\"p\",null,{\"children\":\"Melalui artikel ini, kita akan kembali menelusuri perjalanan #Memory yang telah kita lalui bersama.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__sectionHeader\",\"style\":{\"marginTop\":\"60px\"},\"children\":[[\"$\",\"h2\",null,{\"children\":\"Peringkat Lagu Erine\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__divider\"}]]}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__galleryGrid\",\"style\":{\"marginBottom\":\"60px\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"glassCard page-module__O240YG__card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__imageWrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__rankBadge\",\"children\":\"33\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HKxWODGa4AALMI2?format=jpg&name=large\",\"alt\":\"Kinjirareta Futari\",\"className\":\"page-module__O240YG__image\",\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"cover\"}}]]}],[\"$\",\"h3\",null,{\"children\":\"Kinjirareta Futari\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__votes\",\"children\":\"Rank 33\"}]]}],[\"$\",\"div\",null,{\"className\":\"glassCard page-module__O240YG__card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__imageWrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__rankBadge\",\"children\":\"12\"}],[\"$