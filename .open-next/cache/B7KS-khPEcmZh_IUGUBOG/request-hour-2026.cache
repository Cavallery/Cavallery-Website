":\"page-module__O240YG__recapHeroImage\"}],[\"$\",\"h3\",null,{\"children\":\"Request Hour 2026 Final Recap\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Ketika Request Hour 2026 berakhir, yang tersisa bukan hanya hasil yang tertulis di layar.\"}],[\"$\",\"p\",null,{\"children\":\"Yang tersisa adalah cerita yang berhasil kita ciptakan bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Karena pada akhirnya, kenangan tidak tercipta saat sebuah mimpi terwujud. Kenangan tercipta saat ada banyak orang yang memilih untuk memperjuangkannya bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Dan Request Hour 2026 menjadi salah satu kenangan tersebut.\"}],[\"$\",\"p\",null,{\"children\":\"Melalui artikel ini, kita akan kembali menelusuri perjalanan #Memory yang telah kita lalui bersama.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__sectionHeader\",\"style\":{\"marginTop\":\"60px\"},\"children\":[[\"$\",\"h2\",null,{\"children\":\"Peringkat Lagu Erine\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__divider\"}]]}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__galleryGrid\",\"style\":{\"marginBottom\":\"60px\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"glassCard page-module__O240YG__card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__imageWrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__rankBadge\",\"children\":\"33\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HKxWODGa4AALMI2?format=jpg&name=large\",\"alt\":\"Kinjirareta Futari\",\"className\":\"page-module__O240YG__image\",\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"cover\"}}]]}],[\"$\",\"h3\",null,{\"children\":\"Kinjirareta Futari\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__votes\",\"children\":\"Rank 33\"}]]}],[\"$\",\"div\",null,{\"className\":\"glassCard page-module__O240YG__card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__imageWrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__rankBadge\",\"children\":\"12\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HKxWFmfaMAA3ud1?format=jpg&name=large\",\"alt\":\"Bibir Yang Telah Dicuri\",\"className\":\"page-module__O240YG__image\",\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"cover\"}}]]}],[\"$\",\"h3\",null,{\"children\":\"Bibir yang telah dicuri\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__votes\",\"children\":\"Rank 12\"}]]}],[\"$\",\"div\",null,{\"className\":\"glassCard page-module__O240YG__card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__imageWrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__rankBadge\",\"children\":\"6\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HKxWFmbawAEJ13P?format=jpg&name=large\",\"alt\":\"Blue Rose\",\"className\":\"page-module__O240YG__image\",\"style\":{\"width\":\"100%\",\"height\":\"100%\",\"objectFit\":\"cover\"}}]]}],[\"$\",\"h3\",null,{\"children\":\"Blue Rose\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__votes\",\"children\":\"Rank 6\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapBlock\",\"children\":[\"$L2\",\"$L3\"]}],\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}]}]]}],[\"$La\",\"$Lb\"],\"$Lc\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"B7KS-khPEcmZh_IUGUBOG\"}\n2:[\"$\",\"h3\",null,{\"children\":\"A Memory On Stage\"}]\n3:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Setiap perjalanan pada akhirnya akan menemukan tujuannya masing-masing.\"}],[\"$\",\"p\",null,{\"children\":\"Bagi kita, salah satu tujuan tersebut hadir ketika melihat Erine berdiri di atas panggung JKT48 Request Hour 2026 dan menjadi bagian dari lagu-lagu yang berhasil dibawakan tahun ini.\"}],[\"$\",\"p\",null,{\"children\":\"Melalui dukungan yang diberikan sepanjang periode Request Hour, Erine berkesempatan membawakan:\"}],[\"$\",\"ul\",null,{\"className\":\"page-module__O240YG__songList\",\"children\":[[\"$\",\"li\",null,{\"children\":\"🌹 #6 Blue Rose\"}],[\"$\",\"li\",null,{\"children\":\"💋 #12 Nusumareta Kuchibiru\"}],[\"$\",\"li\",null,{\"children\":\"🔒 #33 Kinjirareta Futari\"}]]}],[\"$\",\"p\",null,{\"children\":\"Setiap lagu membawa cerita dan kenangannya masing-masing. Namun di balik ketiganya, terdapat satu hal yang sama: dukungan dari begitu banyak orang yang memilih untuk berjalan bersama sepanjang perjalanan ini.\"}],[\"$\",\"p\",null,{\"children\":\"Melihat Erine menjadi bagian dari ketiga lagu tersebut menjadi pengingat bahwa setiap suara yang diberikan memiliki arti, dan setiap dukungan yang dititipkan mampu membawa kita selangkah lebih dekat kepada momen yang ingin kita wujudkan bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Dan pada Request Hour 2026, momen itu berhasil menjadi bagian dari #Memory. 🌹\"}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapBlock\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"The Support Behind The Memory\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Setiap kenangan yang berhasil tercipta tentu memiliki cerita di baliknya.\"}],[\"$\",\"p\",null,{\"children\":\"Di sepanjang perjalanan Request Hour 2026, begitu banyak dukungan yang hadir dalam berbagai bentuk. Mulai dari donasi, pengumpulan vote, movement cashback, hingga bantuan dari teman-teman yang memilih untuk menjadi bagian dari perjalanan ini.\"}],[\"$\",\"p\",null,{\"children\":\"Melalui dukungan tersebut, #Memory dapat terus berjalan hingga akhirnya menjadi cerita yang kita kenang bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Berikut adalah rangkuman dukungan yang berhasil dihimpun selama periode Request Hour 2026.\"}]]}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HN1B9D4bIAAlNm2?format=jpg&name=large\",\"alt\":\"The Support Behind The Memory\",\"className\":\"page-module__O240YG__recapImage\"}]]}]\n5:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapBlock\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Vote Distribution\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Setiap suara yang berhasil dihimpun selama periode Request Hour 2026 membawa harapan yang sama: melihat Erine dapat melangkah lebih jauh melalui lagu-lagu yang kita perjuangkan bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Dari berbagai bentuk dukungan yang berhasil terkumpul sepanjang perjalanan #Memory, seluruh vote kemudian dialokasikan ke lagu-lagu yang menjadi bagian dari strategi support selama Request Hour berlangsung.\"}],[\"$\",\"p\",null,{\"children\":\"Berikut adalah distribusi vote yang berhasil dihimpun dan dialokasikan selama periode Request Hour 2026.\"}]]}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HNu7rxDawAAuTlf?format=jpg&name=medium\",\"alt\":\"Vote Distribution\",\"className\":\"page-module__O240YG__recapImage\"}]]}]\n6:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapBlock\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Transparency Report\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Sejak awal, #Memory dibangun di atas kepercayaan dan dukungan dari begitu banyak orang yang memilih untuk menjadi bagian dari perjalanan ini.\"}],[\"$\",\"p\",null,{\"children\":\"Sebagai bentuk tanggung jawab atas kepercayaan tersebut, kami berkomitmen untuk menyampaikan laporan fund dan vote secara terbuka kepada seluruh pihak yang telah mendukung selama periode Request Hour 2026.\"}],[\"$\",\"p\",null,{\"children\":\"Melalui laporan ini, kami berharap setiap teman-teman dapat melihat bagaimana dukungan yang berhasil dihimpun sepanjang perjalanan #Memory dikelola dan dialokasikan selama periode Request Hour berlangsung.\"}],[\"$\",\"p\",null,{\"children\":\"Laporan lengkap dapat diakses melalui tautan berikut:\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__reportLinkWrapper\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://bit.ly/LapoRine_RH2026\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"page-module__O240YG__reportLink\",\"children\":[[\"$\",\"i\",null,{\"className\":\"bx bx-bar-chart-alt-2\"}],\" Laporan Fund dan Vote Request Hour 2026\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__transparencyGrid\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HNu7FTXbUAAO_Zd?format=jpg&name=large\",\"alt\":\"Transparency 1\",\"className\":\"page-module__O240YG__gridImage\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HNu7FTabMAAEzAA?format=jpg&name=large\",\"alt\":\"Transparency 2\",\"className\":\"page-module__O240YG__gridImage\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HNu7FTha8AE3BQL?format=jpg&name=large\",\"alt\":\"Transparency 3\",\"className\":\"page-module__O240YG__gridImage\"}],[\"$\",\"img\",null,{\"src\":\"https://pbs.twimg.com/media/HNu7Fe3aAAAMYJa?format=jpg&name=large\",\"alt\":\"Transparency 4\",\"className\":\"page-module__O240YG__gridImage\"}]]}]]}]\n7:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapBlock\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"The People Behind The Memory\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Di balik setiap suara yang berhasil dihimpun, terdapat begitu banyak orang yang memilih untuk menjadi bagian dari perjalanan ini.\"}],[\"$\",\"p\",null,{\"children\":\"Terima kasih kepada seluruh donatur, partisipan cashback, supporter, partner fanbase, serta teman-teman yang telah membantu menyebarkan informasi dan mendukung movement #Memory dengan caranya masing-masing.\"}],[\"$\",\"p\",null,{\"children\":\"Terima kasih juga kepada seluruh pihak yang telah mempercayakan dukungannya kepada Cavallery selama periode Request Hour 2026 berlangsung.\"}],[\"$\",\"p\",null,{\"children\":\"Setiap bantuan yang diberikan, sekecil apa pun bentuknya, telah menjadi bagian penting dari cerita yang berhasil kita ciptakan bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Karena pada akhirnya, #Memory tidak dibangun oleh satu orang.\"}],[\"$\",\"p\",null,{\"children\":\"Ia tercipta dari begitu banyak langkah kecil yang dipilih untuk berjalan ke arah yang sama. 🌹\"}]]}]]}]\n8:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapBlock\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Until We Create Another Memory\"}],[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__recapText\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Pada akhirnya, setiap perjalanan akan menemukan akhirnya sendiri.\"}],[\"$\",\"p\",null,{\"children\":\"Panggung akan selesai. Lagu terakhir akan berhenti dimainkan. Angka-angka yang selama ini kita hitung perlahan akan kehilangan maknanya seiring berjalannya waktu.\"}],[\"$\",\"p\",null,{\"children\":\"Namun tidak dengan cerita yang berhasil kita ciptakan bersama.\"}],[\"$\",\"p\",null,{\"children\":\"Sebab yang membuat sebuah perjalanan layak untuk dikenang bukanlah seberapa jauh kita berhasil melangkah, melainkan siapa saja yang memilih untuk berjalan bersama hingga akhir.\"}],[\"$\",\"p\",null,{\"children\":\"Dan jika ada satu hal yang dapat kita bawa pulang dari Request Hour 2026, mungkin itu adalah kenyataan bahwa begitu banyak orang yang pernah dipertemukan oleh harapan yang sama, lalu bersama-sama mengubahnya menjadi sebuah kenangan.\"}],[\"$\",\"p\",null,{\"children\":\"Karena pada akhirnya, yang bertahan bukanlah hasil yang berhasil kita capai, melainkan cerita yang berhasil kita tinggalkan.\"}],[\"$\",\"p\",null,{\"children\":\"Terima kasih untuk setiap suara yang diberikan. Untuk setiap dukungan yang dititipkan. Untuk setiap langkah yang ditempuh bersama sepanjang perjalanan #Memory.\"}],[\"$\",\"p\",null,{\"children\":\"Apa yang telah kita perjuangkan mungkin telah mencapai garis akhirnya. Namun kenangan yang tercipta akan selalu menemukan caranya untuk hidup di dalam cerita yang kita bawa setelah ini.\"}],[\"$\",\"p\",null,{\"children\":\"Sampai bertemu di perjalanan berikutnya.\"}],[\"$\",\"p\",null,{\"className\":\"page-module__O240YG__highlightText\",\"children\":\"And until then, thank you for being part of #Memory.\"}]]}]]}]\n9:[\"$\",\"div\",null,{\"className\":\"page-module__O240YG__backBtnWrapper\",\"children\":[\"$\",\"$Ld\",null,{\"href\":\"/\",\"className\":\"page-module__O240YG__backBtn\",\"children\":[[\"$\",\"i\",null,{\"className\":\"bx bx-left-arrow-alt\"}],\" Kembali ke Home\"]}]}]\na:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/028gtpn.yvqjz.css\",\"precedence\":\"next\"}]\nb:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0eb0uh3xjnn~i.css\",\"precedence\":\"next\"}]\nc:[\"$\",\"$Le\",null,{\"children\":[\"$\",\"$f\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@10\"}]}]\n10:null\n","/request-hour-2026":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/08ukuxs.wfqs0.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/02dmpkqb938p6.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/08ukuxs.wfqs0.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/02dmpkqb938p6.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"B7KS-khPEcmZh_IUGUBOG\"}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[70023,[\"/_next/static/chunks/08ukuxs.wfqs0.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_