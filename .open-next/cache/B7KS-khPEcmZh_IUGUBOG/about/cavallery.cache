assName\":\"glassCard\",\"style\":{\"padding\":\"30px 40px\",\"textAlign\":\"left\",\"lineHeight\":\"1.8\",\"margin\":\"0 auto\",\"maxWidth\":800},\"children\":[\"$\",\"ol\",null,{\"style\":{\"paddingLeft\":20,\"color\":\"var(--fg-muted)\",\"listStyleType\":\"decimal\"},\"children\":[[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8,\"paddingLeft\":8},\"children\":\"Mohon untuk aktif dan tidak memancing keributan di grup Cavallery.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Dilarang menghina atau melakukan hate speech kepada sesama anggota grup, Erine, atau member JKT48 lainnya.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Mohon bantuannya untuk berpartisipasi dalam setiap project Cavallery, baik melalui media sosial maupun langsung di lapangan.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Setiap project akan melalui proses brainstorming secara online/offline bersama seluruh anggota grup sebelum diumumkan kembali di grup ini.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Diharapkan membayar uang kas sesuai standar minimum yang sudah ditetapkan untuk melancarkan project-project Cavallery (detail pembayaran kas akan dijelaskan di catatan terpisah).\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Bagi yang tidak membayar kas selama 1 bulan akan diberi peringatan.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Bagi yang tidak membayar kas selama 2 bulan berturut-turut akan diberi peringatan dan ditindak (dikeluarkan).\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Penagihan kas akan dilakukan setiap tanggal 25.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Bagi yang ingin promosi jualan, harap menghubungi pengurus terlebih dahulu.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Hanya pengurus yang dapat mengundang atau mengeluarkan anggota dari grup ini (semu