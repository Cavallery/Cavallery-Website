$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Hanya pengurus yang dapat mengundang atau mengeluarkan anggota dari grup ini (semua anggota grup harus mengisi formulir).\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Hanya pengurus yang boleh menggunakan tag all di grup.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Jika ada yang ingin ditanyakan, silakan menghubungi @MinCav atau @JENDERAL CAVALLERY melalui grup atau personal chat.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Dilarang menghapus album yang ada di grup Line (ini merupakan pelanggaran berat yang dapat dikenai sanksi berat).\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Dilarang menyebarkan link Discord keluar dari grup ini.\"}],[\"$\",\"li\",null,{\"style\":{\"marginBottom\":8},\"children\":\"Pengurus berhak memutuskan peraturan tambahan dengan kesepakatan para pengurus lainnya.\"}]]}]}]]}]\n1b:[\"$\",\"div\",null,{\"className\":\"SectionDivider-module__gOjMsG__dividerWrap\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SectionDivider-module__gOjMsG__line\"}],[\"$\",\"div\",null,{\"className\":\"SectionDivider-module__gOjMsG__icon\",\"children\":\"♞\"}],[\"$\",\"div\",null,{\"className\":\"SectionDivider-module__gOjMsG__line\"}]]}]\n1c:[\"$\",\"div\",null,{\"className\":\"page-module__TIw4ja__domisiliSection\",\"children\":[[\"$\",\"div\",null,{\"className\":\"badge\",\"style\":{\"marginBottom\":16},\"children\":[[\"$\",\"i\",null,{\"className\":\"bx bx-group\"}],\" Kepengurusan\"]}],[\"$\",\"h2\",null,{\"className\":\"page-module__TIw4ja__sectionH\",\"children\":\"Struktur Organisasi Cavallery\"}],[\"$\",\"div\",null,{\"className\":\"divider\",\"style\":{\"marginBottom\":16}}],[\"$\",\"p\",null,{\"style\":{\"color\":\"var(--fg-dim)\",\"marginBottom\":32,\"maxWidth\":600,\"marginInline\":\"auto\",\"textAlign\":\"center\"},\"children\":\"Struktur kepengurusan resmi, program kerja, dan peta